{
  "name": "cordnit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && npm run build:cms && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "cms:admin": "tsx --conditions=react-server --env-file=.env.local scripts/cms/create-super-admin.ts",
    "cms:seed": "tsx --conditions=react-server --env-file=.env.local scripts/cms/seed.ts",
    "cms:verify": "tsx --conditions=react-server --env-file=.env.local scripts/cms/verify.ts",
    "cms:admin:prod": "tsx --conditions=react-server scripts/cms/create-super-admin.ts",
    "cms:seed:prod": "tsx --conditions=react-server scripts/cms/seed.ts",
    "cms:verify:prod": "tsx --conditions=react-server scripts/cms/verify.ts",
    "cms:migrate-cta": "tsx --conditions=react-server --env-file=.env.local scripts/cms/migrate-cta.ts",
    "cms:migrate-cta:prod": "tsx --conditions=react-server scripts/cms/migrate-cta.ts",
    "cms:backfill-seo": "tsx --conditions=react-server --env-file=.env.local scripts/cms/backfill-seo.ts",
    "cms:backfill-seo:prod": "tsx --conditions=react-server scripts/cms/backfill-seo.ts",
    "build:cms": "npm run cms:admin:prod && npm run cms:seed:prod",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "antd": "^6.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^59.11.2",
    "vitest": "^4.1.11"
  }
}
