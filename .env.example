# Copy to .env.local and fill in. Never commit real values.
# Validated at runtime by server/env.ts. Full reference: project-docs/22-devops/ENVIRONMENT-VARIABLES.md

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cordinit.com

# ── Database (Supabase Postgres) ────────────────────────────────────────
# Runtime: Supavisor transaction pooler (port 6543). Dashboard > Connect > Transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations / scripts: session pooler or direct connection (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: connections per server instance (default 5).
# DB_POOL_MAX=5

# ── Supabase Auth (CMS login) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the create-super-admin script and admin password change.
SUPABASE_SECRET_KEY=sb_secret_...

# ── CMS ─────────────────────────────────────────────────────────────────
# Login usernames map to <username>@<this domain>. Never receives mail.
CMS_ADMIN_EMAIL_DOMAIN=cms.cordinit.com
# At least 32 chars. Bearer token for POST /api/revalidate. Generate: openssl rand -hex 32
CMS_REVALIDATE_SECRET=

# ── Google Sheets (lead mirror) ─────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Email notifications (Resend) ────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
